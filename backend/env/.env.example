# Application
SECRET_KEY=replace-with-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
DATABASE_URL=postgresql+psycopg2://belvo_user:belvo_password@localhost:5432/belvo_db

# Belvo API
BELVO_BASE_URL=https://sandbox.belvo.com
BELVO_SECRET_ID=your-secret-id
BELVO_SECRET_PASSWORD=your-secret-password
# Provide comma-separated link IDs obtained from Belvo dashboard
BELVO_LINK_IDS=link-id-1,link-id-2
